# Copy to .env.local. Get these from Firebase console -> Project settings
# -> your web app. This project must be the SAME GCP project the AEGIS
# services deploy into (Firebase is just Google's frontend layer on top
# of the same Firestore/Auth infra).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
